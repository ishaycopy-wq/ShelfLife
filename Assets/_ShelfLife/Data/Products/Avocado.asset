  m_Script: {fileID: 11500000, guid: b2b542a1152570140995b90f20d27a9c, type: 3}
  m_Name: Avocado
  m_EditorClassIdentifier: Assembly-CSharp::ProductData
  productName: Avocado
  price: 12.5
  productColor: {r: 0.19607843, g: 0.39215687, b: 0.15686275, a: 1}
  receiptDescription: ripe briefly
  catchLines:
  - '"You only caught me for my price tag."'
  - '"This doesn''t make us friends."'
  - '"My therapist said to let go. You didn''t."'
  missLines:
  - '"I knew you''d drop me. Everyone does."'
  - '"At least the floor doesn''t judge me."'
  - '"I hope the stain haunts you."'
  rejectionLines:
  - '"You picked the BANANA? He''s DAYS from expiry."'
  - '"She costs four shekel. I was eighty-nine."'
